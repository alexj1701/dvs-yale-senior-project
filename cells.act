namespace cell {

export defcell g0n_12ax0 (bool? in[3]; bool! out)
{
   prs {
   [keeper=0] in[1]<10,15> & in[2]<10,15> -> out-
   [keeper=0] ~in[0]<12,22> -> out+
   }
}

export defcell g2n_01ax0 (bool? in[3]; bool! out)
{
   prs {
   [keeper=0] in[0]<8,12> & in[1] -> out-
   [keeper=0] ~in[2]<8,12> -> out+
   }
}

export defcell gffx0 (bool? in[2]; bool! out)
{
   prs {
   [keeper=0] in[1]<60,68> -> out-
   [keeper=0] ~in[0]<20,160> -> out+
   }
}

export defcell gffx1 (bool? in[2]; bool! out)
{
   prs {
   [keeper=0] in[1]<12,24> -> out-
   [keeper=0] ~in[0]<10,15> -> out+
   }
}

export defcell gpd1x0 (bool? in[1]; bool! out)
{
   prs {
   [keeper=0] in[0]<60,68> -> out-
   }
}

export defcell gpd1x1 (bool? in[1]; bool! out)
{
   prs {
   [keeper=0] in[0]<10,15> -> out-
   }
}

export defcell gpd1x2 (bool? in[1]; bool! out)
{
   prs {
   [keeper=0] in[0] -> out-
   }
}

export defcell gpd2x0 (bool? in[2]; bool! out)
{
   prs {
   [keeper=0] in[0]<10,15> & in[1]<10,15> -> out-
   }
}

export defcell gpd2x1 (bool? in[2]; bool! out)
{
   prs {
   [keeper=0] in[0] & in[1] -> out-
   }
}

export template<pint w,l> defcell p0(bool? in[2]; bool! out) {
  prs { passp<w,l> (in[0],in[1],out) }
}

export template<pint w,l> defcell n0(bool? in[2]; bool! out) {
  prs { passn<w,l> (in[0],in[1],out) }
}

export template<pint w,l> defcell t0(bool? in[3]; bool! out) {
  prs { transgate<w,l> (in[0],in[1],in[2],out) }
}

export defcell p1(bool? in[2]; bool! out) {
  prs { passp (in[0],in[1],out) }
}

export defcell n1(bool? in[2]; bool! out) {
  prs { passn (in[0],in[1],out) }
}

export defcell t1(bool? in[3]; bool! out) {
  prs { transgate (in[0],in[1],in[2],out) }
}

export template<pint w,l> defcell c0(bool in; bool out) {
  prs { cap<w,l> (in,out) }
}

export defcell c1(bool in; bool out) {
  prs { cap (in,out) }
}



}
