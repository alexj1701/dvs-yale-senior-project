// 4T Global shutter APS
// Enable by Vgfb = Vdd
// Disable by CR = 0
// in[4] -> in[Vpd, CR, TX, CS]
// out -> apsOut
defproc aps (bool? in[4]; bool! out) {

    bool a, b;
    prs {

        // .42/.35 um
        // G = CR, S = Vdd, D = Vpd ??
        passn<17,14> (in[1], Vdd, in[0])

        // .42/.4 um
        // G = TX, S = Vpd, D = "a", gate of next
        passn<17,16> (in[2], in[0], a)

        // .6/.35 um
        // G = a, S = Vdd, D = b
        passn<24,14> (a, Vdd, b)

        // .7/.35 um
        // G = CS, S = b, D = out "apsOut"
        passn<28,14> (in[3], b, out)

    }

}