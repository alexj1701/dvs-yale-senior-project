import globals;

// Pre-amplifier
// design ref https://www.linkedin.com/pulse/five-transistor-ota-comprehensive-design-methodology-kassem-r0qhe/
// in[2] -> [VprAmp, VIprBuff]
// out -> VprBuf
defproc ota_buff (bool? in[2]; bool! out) {
    
    
    pint w0 = 48, l0 = 200;

    bool a, b_l, b_r;

    prs { 

        // Biasing current source
        passp <w0,l0> (in[1], Vdd, a)

        // PMOS differential pair
        // pos / left
        passp <w0,l0> (in[0], a, b_l)
        // neg / right
        passp <w0,l0> (b_r, a, b_r)

        // NMOS mirror load
        // left
        passn <w0,l0> (b_l, GND, b_l)
        // right
        passn <w0,l0> (b_l, GND, b_r)
    }

    out = b_r;

}