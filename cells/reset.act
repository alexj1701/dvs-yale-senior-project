import globals; 

// Common-Gate Logarithmic photoreceptor
// in[3] -> [Vreset, VON, VnOFF]
// out -> reset
defproc reset (bool? in[3]; bool! out) {
    
    bool a, non;
    prs { 

        // ~a -> reset+
        [keeper=0] ~a -> out+

        // ~Vreset -> reset-
        [keeper=0] in[0] -> out-

        // VON -> non-
        in[1] => non-

        // VnOFF NAND non
        in[2] & non => a-

        //200fF cap
        //cap<200> (out, GND)


    }
}