

// Programmable Event Threshold Comparators
// in[3] -> in[Vdiff, VIon, VIoff]
// out[2] -> out[VON, VnOFF]
defproc comparators (bool? in[3]; bool! out[2]) {
    
    // TODO: Set sizing

    prs {
        
    [keeper=0] ~in[0] -> out[0]+
    [keeper=0] in[1] -> out[0]-

    [keeper=0] ~in[0] -> out[1]+
    [keeper=0] in[2] -> out[1]-

    }

}