import globals;

// Change Amplifier
// in[3] -> in[Vpr, Vidiff, nRstChAmp]
// out -> Vdiff
defproc champ (bool? in[3]; bool! out) {

    // Internal linking variable
    bool a;

    pint wp = 20, lp = 160;
    pint wn = 60, ln = 68;

    prs {
        //200fF cap
        cap<200> (in[0], a)

        //7fF cap
        cap<7> (a, out)

        // G = nRstChAmp, S = a, D = out
        // Unknown size
        [keeper=0] passp (in[2], a, out)

        // PMOS
        // G = a, S = Vdd, D = out
        // Unknown size
        [keeper=0] passp <wp, lp> (a, Vdd, out)

        // NMOS Current sink
        // Vidiff, out-
        [keeper=0] in[1] <wn, ln> -> out-

    }

}
